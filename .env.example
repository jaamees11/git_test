# ─── Company branding (shown on the website) ─────────────────────────────────
NEXT_PUBLIC_COMPANY_NAME="Hunter Valley Solar"
NEXT_PUBLIC_PHONE="0400 000 000"

# ─── Admin dashboard ──────────────────────────────────────────────────────────
# Password to access /admin (view all leads)
ADMIN_PASSWORD=changeme123

# ─── Email alerts ─────────────────────────────────────────────────────────────
# Fires an email to ALERT_EMAIL whenever a new lead submits.
#
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to myaccount.google.com/apppasswords
#   3. Create an App Password (select "Mail" and "Other")
#   4. Paste the 16-char password as SMTP_PASS below
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-16-char-app-password

# Email address to receive lead alert notifications
ALERT_EMAIL=youremail@gmail.com
